{
	"compilerOptions": {
		"allowJs": true,
		"checkJs": true,

		"target": "es2023",
		"lib": ["es2023", "es2024.Regexp"],
		"module": "Node16",
		"moduleResolution": "Node16",

		"strict": true,

		"allowImportingTsExtensions": true,
		"rewriteRelativeImportExtensions": true,
		"skipLibCheck": true,

		"verbatimModuleSyntax": true,
		"isolatedModules": true,

		"declaration": true,
		"rootDir": "src",
		"outDir": "out"
	},
	"files": [
		"src/index.js",
		"src/json.js",
		"src/v1-compat.js",
		"src/dessert.js"
	],
	"include": ["src/**/*"],
	"exclude": ["test/**/*"]
}
